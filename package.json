{
  "name": "bumpvet",
  "version": "0.1.0",
  "description": "Should a human look at this dependency update before it is merged?",
  "type": "module",
  "bin": {
    "bumpvet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsc -p tsconfig.json && node dist-eval/eval/run.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "keywords": [
    "npm",
    "supply-chain",
    "security",
    "lockfile",
    "dependabot",
    "renovate",
    "provenance"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
