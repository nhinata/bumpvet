{
  "name": "bumpvet",
  "version": "0.3.0",
  "description": "Should a human look at this dependency update before it is merged?",
  "type": "module",
  "bin": {
    "bumpvet": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsc -p tsconfig.json && node dist-eval/eval/run.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "keywords": [
    "npm",
    "supply-chain",
    "security",
    "lockfile",
    "dependabot",
    "renovate",
    "provenance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhinata/bumpvet.git"
  },
  "homepage": "https://github.com/nhinata/bumpvet#readme",
  "bugs": "https://github.com/nhinata/bumpvet/issues",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
