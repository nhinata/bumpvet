{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "dist-eval",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src", "test", "eval", "action"]
}
