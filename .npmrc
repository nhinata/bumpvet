# Dependencies' install scripts never run in this repository, locally or in CI:
# nothing here needs them, and they run other people's code on install. This
# is the one place that says so; CI, README.md and CONTRIBUTING.md point here.
#
# It also skips `pre`/`post` scripts and lifecycle scripts such as `prepare`,
# and applies to `npm publish` and `npm version` (`prepublishOnly`,
# `preversion`), so build and release steps must be run explicitly.
#
# If a dependency ever needs its install script, allow only that package
# rather than turning install scripts back on for every package: with npm 11
# (Node.js 24 and later), remove `ignore-scripts=true`, set `strict-allow-scripts=true`, and
# run `npm approve-scripts <pkg>`, which records the package under
# `allowScripts` in package.json; any other install script then fails the
# install. `allowScripts` has no effect while `ignore-scripts=true`. npm 10
# (bundled with Node.js 22) has neither setting, so there, removing
# `ignore-scripts=true` runs every install script. That is why this file uses
# `ignore-scripts=true`, the one setting both npm 10 and npm 11 honour.
ignore-scripts=true
